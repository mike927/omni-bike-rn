{
  "name": "omni-bike-rn",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios --device",
    "ios:release": "node scripts/ios-release.mjs",
    "ios:sim": "expo run:ios",
    "apple-health:pull-logs": "node scripts/pull-apple-health-diagnostics.mjs",
    "skills:install": "node scripts/install-skills.mjs",
    "db:generate": "drizzle-kit generate && prettier --single-quote --write drizzle/migrations.js",
    "db:check": "drizzle-kit check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:changed": "jest --changedSince=main",
    "test:watch-lifecycle": "swiftc -swift-version 5 -o /tmp/omni-watch-lifecycle-tests 'ios/OmniBikeWatch Watch App/WatchLifecycle.swift' native-tests/WatchLifecycleTests.swift && /tmp/omni-watch-lifecycle-tests",
    "ci:gate": "npm run lint && npm run typecheck && npm test -- --ci --runInBand",
    "build:smoke": "expo export -p ios -p android",
    "eas:build:android": "npx eas-cli build --platform android --profile preview",
    "eas:build:android:dev": "npx eas-cli build --platform android --profile development",
    "eas:env:push:preview": "npx eas-cli env:push preview --path .env",
    "eas:env:push:dev": "npx eas-cli env:push development --path .env",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": "eslint --fix --max-warnings 0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "apple-health-workout": "file:modules/apple-health-workout",
    "buffer": "^6.0.3",
    "drizzle-orm": "^0.45.2",
    "expo": "^57.0.19",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-drizzle-studio-plugin": "^0.2.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "^57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health": "^1.19.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "watch-connectivity": "file:modules/watch-connectivity",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@react-native/jest-preset": "^0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.10",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~57.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-health",
          "apple-health-workout",
          "watch-connectivity"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
