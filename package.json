{
  "name": "omni-bike-rn",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios --device",
    "ios:release": "npm run ios:release:both",
    "ios:release:check": "node scripts/ios-release.mjs both --check",
    "ios:release:phone": "node scripts/ios-release.mjs phone",
    "ios:release:watch": "node scripts/ios-release.mjs watch",
    "ios:release:both": "node scripts/ios-release.mjs both",
    "ios:sim": "expo run:ios",
    "apple-health:pull-logs": "node scripts/pull-apple-health-diagnostics.mjs",
    "skills:install": "node scripts/install-skills.mjs",
    "db:generate": "drizzle-kit generate && prettier --single-quote --write drizzle/migrations.js",
    "db:check": "drizzle-kit check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:changed": "jest --changedSince=main",
    "test:watch-lifecycle": "d=$(mktemp -d /tmp/omni-watch-lifecycle.XXXXXX) && swiftc -swift-version 5 -default-isolation MainActor -o \"$d/tests\" 'ios/OmniBikeWatch Watch App/WatchLifecycle.swift' native-tests/WatchLifecycleTests.swift && \"$d/tests\"; status=$?; rm -rf \"$d\"; exit $status",
    "ci:gate": "npm run check:dependencies && npm run lint && npm run typecheck && npm run test:tooling && npm test -- --ci --runInBand",
    "build:smoke": "expo export -p ios -p android",
    "eas:build:android": "npx eas-cli build --platform android --profile preview",
    "eas:build:android:dev": "npx eas-cli build --platform android --profile development",
    "eas:env:push:preview": "npx eas-cli env:push preview --path .env",
    "eas:env:push:dev": "npx eas-cli env:push development --path .env",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "husky",
    "metro:reload": "node scripts/metro.mjs reload",
    "metro:menu": "node scripts/metro.mjs menu",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "audit:report": "node scripts/dependency-audit.mjs",
    "test:tooling": "node --test scripts/__tests__/*.test.mjs",
    "ios:release:evidence": "node scripts/check-release-evidence.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": "eslint --fix --max-warnings 0",
    "ios/OmniBikeWatch Watch App/*.swift": "bash -c 'npm run test:watch-lifecycle'"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "apple-health-workout": "file:modules/apple-health-workout",
    "buffer": "^6.0.3",
    "drizzle-orm": "^0.45.2",
    "expo": "^58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-drizzle-studio-plugin": "^0.2.1",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "watch-connectivity": "file:modules/watch-connectivity",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~58.0.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-expo": "~58.0.14",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "test-renderer": "~1.3.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "@expo/plist@0.1.3": {
      "@xmldom/xmldom": "^0.8.15"
    },
    "glob@>=9 <14": "^14.0.3",
    "minimatch@>=9 <11": "^11.0.4",
    "xcode": "^4.0.0"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "apple-health-workout",
          "watch-connectivity"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "engines": {
    "node": "^24.3.0"
  }
}
